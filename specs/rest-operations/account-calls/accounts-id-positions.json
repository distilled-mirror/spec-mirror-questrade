    {
      "type": "code",
      "language": "JSON",
      "text": "{\n     \"positions\": [\n           {\n                \"symbol\": \"THI.TO\",\n                \"symbolId\": 38738,\n                \"openQuantity\": 100,\n                \"currentMarketValue\": 6017,\n                \"currentPrice\": 60.17,\n                \"averageEntryPrice\": 60.23,\n                \"closedPnl\": 0,\n                \"openPnl\": -6,\n                \"totalCost\": false,\n                \"isRealTime\": \"Individual\",\n                \"isUnderReorg\": false\n           }\n      ]\n }"
