{
  "url": "https://www.questrade.com/api/documentation/rest-operations/market-calls/markets-quotes-id",
  "title": "GET markets/quotes/:id",
  "summary": "Retrieves a single Level 1 market data quote for one or more symbols.",
  "blocks": [
    {
      "type": "paragraph",
      "text": "IMPORTANT NOTE: Questrade user needs to be subscribed to a real-time data package, to receive market quotes in real-time, otherwise call to get quote is considered snap quote and limit per market can be quickly reached. Without real-time data package, once limit is reached, the response will return delayed data. (Please check \"delay\" parameter in response always)"
    },
