{
  "url": "https://www.questrade.com/api/documentation/rest-operations/market-calls/symbols-id",
  "title": "GET symbols/:id",
  "summary": "Retrieves detailed information about one or more symbol.",
  "blocks": [
    {
      "type": "heading",
      "level": 3,
      "id": "request-parameters",
      "text": "Request parameters"
    },
    {
      "type": "table",
      "caption": "Request parameters",
      "columns": [
        "Parameter",
        "Type",
        "Description"
      ],
      "rows": [
        {
          "cells": [
            "id",
            "integer",
            "Internal symbol identifier. Can occur in the ‘Location’ header only. Mutually exclusive with ‘ids’ parameter."
          ]
        },
        {
          "cells": [
            "ids",
            "Complex",
            "Comma-separated list of symbol ids."
          ]
        },
        {
          "cells": [
            "id",
            "Integer",
            "Internal symbol identifier"
          ],
          "level": 2
        },
        {
          "cells": [
            "names",
            "Complex",
            "Comma separated list of symbol names."
          ]
        },
        {
          "cells": [
            "name",
            "String",
            "Symbol name"
          ],
          "level": 2
        }
      ]
    },
    {
      "type": "paragraph",
      "text": "Notes: Either list of ids or names can be specified, but not both."
    },
